---
import "../styles/global.css";

const { pathname } = Astro.url;

const routes = [
  { name: "Home", path: "/" },
  { name: "Collection", path: "/products" },
  { name: "About", path: "/about" },
];
---

<nav
  class="bg-stone-50/90 backdrop-blur-md border-b border-stone-200 sticky top-0 z-50"
>
  <div class="container mx-auto px-6 h-20 flex items-center justify-between">
    <!-- > LOgo -->
    <a href="/" class="flex items-center gap-3 group">
      <div
        class="w-10 h-10 border border-amber-600 flex items-center justify-center group-hover:bg-amber-600 transition-all duration-300"
      >
        <span class="text-amber-600 group-hover:text-white font-serif text-2xl"
          >A</span
        >
      </div>
      <div class="flex flex-col">
        <span
          class="text-xl font-light tracking-[0.3em] uppercase text-stone-900 font-serif leading-none"
        >
          Aura & Arc
        </span>
        <span
          class="text-[10px] tracking-[0.2em] uppercase text-stone-500 font-medium"
        >
          Fine Jewelry
        </span>
      </div>
    </a>

    <!-- > Routes -->
    <ul class="flex items-center gap-10">
      {
        routes.map((route) => {
          const isActive =
            pathname === route.path ||
            (route.path !== "/" && pathname.startsWith(route.path));

          return (
            <li>
              <a
                href={route.path}
                class={`text-xs uppercase tracking-[0.2em] font-medium transition-all duration-300 relative py-2
                  ${
                    isActive
                      ? "text-amber-700"
                      : "text-stone-500 hover:text-amber-700"
                  }`}
              >
                {route.name}
                {isActive && (
                  <span class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-1 h-1 bg-amber-700 rounded-full" />
                )}
              </a>
            </li>
          );
        })
      }
    </ul>

    <!-- > Reflection anchor -->
    <div class="hidden md:block">
      <a
        href="/reflection"
        class="border border-stone-900 text-stone-900 px-6 py-2 text-[10px] uppercase tracking-widest font-bold hover:bg-stone-900 hover:text-white transition-all duration-300"
      >
        Reflection
      </a>
    </div>
  </div>
</nav>
