---
import type { Product } from "../lib/product";

/**
 * Requerimiento de TS: Definición explícita de Props.
 * Usamos la clase Product como tipo para asegurar que los métodos existan.
 */
interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<article class="group">
  <a href={`/products/${product.getSlug()}`} class="block no-underline">
    <!-- Contenedor de Imagen con Efecto de Lujo -->
    <div class="relative aspect-square overflow-hidden bg-stone-200 mb-4 rounded-sm border border-stone-100 shadow-sm">
      <img
        src={product.image}
        alt={product.title}
        class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-110"
        loading="lazy"
      />
      
      <!-- Badge de disponibilidad (Opcional) -->
      {!product.isInStock() && (
        <div class="absolute top-2 right-2 bg-white/90 backdrop-blur-sm px-2 py-1">
          <span class="text-[9px] uppercase tracking-tighter text-stone-500 font-bold">
            Out of Stock
          </span>
        </div>
      )}
    </div>

    <!-- Información del Producto -->
    <div class="space-y-1">
      <h3 class="text-stone-900 font-serif text-lg font-light leading-snug group-hover:text-amber-700 transition-colors">
        {product.title}
      </h3>
      
      <div class="flex justify-between items-center">
        <p class="text-amber-600 font-medium text-sm tracking-wide">
          {product.getFormattedPrice()}
        </p>
        <span class="text-[10px] text-stone-400 uppercase tracking-widest font-bold">
          {product.category}
        </span>
      </div>
    </div>
  </a>

  <!-- CTA Discreto -->
  <div class="mt-4 pt-4 border-t border-stone-100 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
    <a 
      href={`/products/${product.getSlug()}`}
      class="text-[10px] uppercase tracking-[0.2em] text-stone-900 font-bold hover:text-amber-600 transition-colors"
    >
      Explore Details →
    </a>
  </div>
</article>