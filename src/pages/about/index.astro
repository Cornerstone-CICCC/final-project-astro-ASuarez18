---
import Layout from "../../layouts/Layout.astro";
---

<Layout style="bg-stone-50">
  <main class="container mx-auto px-6 py-20">
    <!-- > Header Section -->
    <header class="max-w-3xl mx-auto text-center mb-16">
      <span
        class="text-amber-600 font-medium tracking-[0.2em] uppercase text-sm mb-4 block"
      >
        Our Story
      </span>
      <h1
        class="text-4xl md:text-5xl font-light text-stone-900 mb-8 font-serif"
      >
        The Intersection of Craft & Logic
      </h1>
      <p class="text-lg text-stone-600 leading-relaxed font-light">
        Aura & Arc was born from a desire to blend the timeless elegance of fine
        jewelry with the precision of modern software architecture. Based in the
        heart of Vancouver, we believe that beauty lies in the structure.
      </p>
    </header>

    <!-- > Content Sections -->
    <div
      class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center max-w-5xl mx-auto mb-24"
    >
      <div class="space-y-6">
        <h2 class="text-2xl font-serif text-stone-900">Timeless Design</h2>
        <p class="text-stone-600 leading-relaxed font-light">
          Every piece in our collection is selected based on geometric harmony
          and minimalist principles. We focus on clean lines and sustainable
          materials that resonate with the modern individual.
        </p>
      </div>

      <div
        class="bg-stone-200 aspect-square rounded-sm overflow-hidden flex items-center justify-center border border-stone-300 shadow-sm group"
      >
        <img
          src="/images/gold-ring.webp"
          alt="Minimalist Gold Ring - Aura & Arc Collection"
          class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-700 ease-in-out"
        />
      </div>
    </div>

    <!-- > Our story -->
    <section
      class="bg-white border border-stone-200 p-10 md:p-16 max-w-4xl mx-auto text-center shadow-sm"
    >
      <h2
        class="text-xs uppercase tracking-[0.3em] text-amber-600 font-bold mb-6"
      >
        Our Story
      </h2>
      <p class="text-stone-800 font-serif text-xl mb-6 leading-snug">
        "Founded on the West Coast, Aura & Arc represents the harmony between
        architectural precision and the fluid beauty of fine jewelry."
      </p>
      <div class="w-12 h-px bg-stone-300 mx-auto mb-6"></div>
      <p class="text-sm text-stone-500 max-w-lg mx-auto leading-relaxed">
        What began as a final software development project in Vancouver, BC,
        evolved into a curated collection where every piece is managed through
        the lens of clean code and Object-Oriented principles. We believe that
        just as a perfect diamond requires the right structure, a digital
        experience requires a solid technical foundation.
      </p>
    </section>
  </main>
</Layout>
