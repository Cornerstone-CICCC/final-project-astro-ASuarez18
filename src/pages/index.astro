---
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";
import { ProductCatalog } from "../lib/product";

const catalog = new ProductCatalog();
const featuredJewelry = catalog.getAllProducts().slice(0, 3);
---

<Layout style="bg-stone-50">
  <!-- > Hero Section -->
  <main
    class="flex flex-col items-center justify-center min-h-[60vh] text-center px-6 border-b border-stone-200"
  >
    <div class="max-w-2xl">
      <span
        class="text-amber-600 font-medium tracking-[0.2em] uppercase text-sm mb-4 block"
      >
        Vancouver • Est. 2026
      </span>
      <h1
        class="text-5xl md:text-6xl font-light text-stone-900 mb-6 font-serif"
      >
        Aura & Arc
      </h1>
      <p class="text-2xl text-stone-600 mb-10 leading-relaxed font-light">
        Simply... Jewelry. <br />
        <span class="text-lg">Technical structure, timeless beauty.</span>
      </p>

      <div class="flex gap-6 justify-center">
        <a
          href="/products"
          class="bg-stone-900 text-white px-10 py-4 rounded-sm hover:bg-stone-800 transition-all uppercase text-xs tracking-widest font-bold hover:shadow-lg hover:scale-110"
        >
          View Collection
        </a>
      </div>
    </div>
  </main>

  <!-- >Feautured products -->
  <section class="container mx-auto px-6 py-20">
    <div class="flex flex-col md:flex-row justify-between items-baseline mb-12">
      <h2 class="text-3xl font-light text-stone-900 font-serif">
        Season Products
      </h2>
      <a
        href="/products"
        class="text-stone-500 hover:text-amber-600 transition-colors text-sm uppercase tracking-widest"
      >
        Explore all catalog →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      {featuredJewelry.map((piece) => <ProductCard product={piece} />)}
    </div>
  </section>
</Layout>
